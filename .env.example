# ============================================================
#  .env.example — Production Multi-Document Conversational RAG
#  Copy to .env and adjust values. All defaults are $0 / local.
# ============================================================

# --- LLM (defaults to local Ollama — $0 cost) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1

# --- Embedding & Reranking (local sentence-transformers — $0 cost) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Hybrid Retrieval (Dense + BM25 + RRF) ---
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_CANDIDATES=15
RRF_K=60

# --- Cross-Encoder Reranking ---
# ms-marco-MiniLM-L-6-v2 outputs raw logits (may be negative).
# Queries whose best rerank_score falls below this threshold trigger abstention.
RERANK_THRESHOLD=-1.5

# --- Persistent Storage ---
CHROMA_PERSIST_DIR=./chroma_db
SQLITE_DB_PATH=./rag_memory.sqlite
BM25_INDEX_PATH=./chroma_db/bm25_corpus.json
